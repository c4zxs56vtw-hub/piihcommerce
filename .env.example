# ─── Spring Boot backend URL ──────────────────────────────────────────────────
# Leave empty to use local fallback data (no backend needed)
# Set to your server address when Spring Boot is running
VITE_API_URL=

# Examples:
# VITE_API_URL=http://localhost:8080
# VITE_API_URL=https://api.your-domain.com

# ─── Compte admin de TEST (dev local sans backend uniquement) ─────────────────
# À mettre dans .env.local (ignoré par git). Ignoré en production et dès que
# VITE_API_URL est renseigné : l'authentification est alors faite par Spring Boot.
# VITE_DEV_ADMIN_EMAIL=
# VITE_DEV_ADMIN_PASSWORD=
